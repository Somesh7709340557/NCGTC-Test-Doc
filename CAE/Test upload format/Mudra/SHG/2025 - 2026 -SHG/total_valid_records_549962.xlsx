        function fetchclaimData(fileId) {

            var myData;
            var params = { fileId: fileId }
            var pageUrl = "ApproveCGQuote.aspx";

            $.ajax({
                type: "POST",
                url: pageUrl + "/LoadClaimBillingData",
                data: JSON.stringify(params),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    debugger;
                    myData = data.d;

                    dataJasonPopups = myData;

                    fetchApproveClaimData();

                }
            });


        }
        function getMLIAndUserDetails() {
            debugger;
            var currentFileId = document.getElementById('hdfFileId');
            var myData;
            var params = { fileId: 0, userId: 0 }
            var pageUrl = "Home.aspx";

            $.ajax({
                type: "POST",
                url: pageUrl + "/LoadMLIDetailsData",
                data: JSON.stringify(params),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {

                    myData = data.d;

                    dataJson = myData;

                    setMLIAndUserApproverDetails();

                }
            });
        }

        function setMLIAndUserApproverDetails() {

            document.getElementById('ContentPlaceHolder1_labelApproverMLIName').innerHTML = dataJson.MLIName;
            document.getElementById('ContentPlaceHolder1_labelApproverMLIApproverName').innerHTML = dataJson.UserName;
            document.getElementById('ContentPlaceHolder1_labelApproverMLIApproverFirstName').innerHTML = dataJson.FirstName;
            document.getElementById('ContentPlaceHolder1_labelApproverMLIApproverLastName').innerHTML = dataJson.LastName;
        }

        function fetchclaimDataAll(fileId) {

            var myData;
            var params = { fileId: fileId }
            var pageUrl = "ApproveCGQuote.aspx";

            $.ajax({
                type: "POST",
                url: pageUrl + "/LoadAllClaimBillingData",
                data: JSON.stringify(params),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    myData = data.d;

                    dataJasonPopups = myData;
                    fetchAllApproveClaimData();

                }
            });


        }

        function fetchApproveClaimData() {
            debugger

            document.getElementById('ContentPlaceHolder1_LabelPortFolioName').innerHTML = dataJasonPopups.PortFolioUniqueId;
            document.getElementById('ContentPlaceHolder1_LabelPortfoiloSHG').innerHTML = dataJasonPopups.PortFolioUniqueId;
            document.getElementById('ContentPlaceHolder1_LabelSHGPortfolio').innerHTML = dataJasonPopups.PortFolioUniqueId;
