    <script type="text/javascript">

        function changeDrops(selEle) {
            //  alert('Selected value : ' + selEle.value.toString() + '\nSelected item : ' + selEle.options[selEle.selectedIndex].innerHTML);
            if (selEle.value.toString() == "1") {
                // Approved select to all ------------
                var str = '#ctl00_ContentPlaceHolder1_RadGridClaim_ctl00 tbody tr';
                var cnt = $(str).length;
                for (var i = 0; i < cnt; i++) {
                    var strApproved = '#ctl00_ContentPlaceHolder1_RadGridClaim_ctl00 tbody tr ';
                    $($(strApproved)[i]).find('select').val(1);
                }

            } else if (selEle.value.toString() == "2") {
                //  Rejected select to all  ------------
                var str = '#ctl00_ContentPlaceHolder1_RadGridClaim_ctl00 tbody tr';
                var cnt = $(str).length;
                for (var i = 0; i < cnt; i++) {
                    var strRejected = '#ctl00_ContentPlaceHolder1_RadGridClaim_ctl00 tbody tr ';
                    $($(strRejected)[i]).find('select').val(2);
                }
            }
        };

        function onlyDotsAndNumbers(event) {
            var charCode = (event.which) ? event.which : event.keyCode
            if (charCode == 46) {
                return true;
            }
            if (charCode > 31 && (charCode < 48 || charCode > 57))
                return false;

            return true;
        }


        function intToFormatData(controlId) {

            var jcontrolId = document.getElementById(controlId).id;
            var nStr = document.getElementById(controlId).value;


            nStr += '';
            x = nStr.split('.');
            x1 = x[0];
            x2 = x.length > 1 ? '.' + x[1] : '';

            if (x2.length == 0) {
                x2 = '.00';
            } else if (x2.length == 2) {
                x2 = '.' + x[1] + '0';
            } else {
                x2 = '.' + x[1];
            }
            var rgx = /(\d+)(\d{3})/;
            var z = 0;
            var len = String(x1).length;
            var num = parseInt((len / 2) - 1);

            while (rgx.test(x1)) {
                if (z > 0) {
                    x1 = x1.replace(rgx, '$1' + ',' + '$2');
                }
                else {
                    x1 = x1.replace(rgx, '$1' + ',' + '$2');
                    rgx = /(\d+)(\d{2})/;
                }
                z++;
                num--;
                if (num == 0) {
                    break;
                }
            }
            document.getElementById(controlId).value = x1 + x2;

        }

        function ValidateGrid() {
            var str = '#ctl00_ContentPlaceHolder1_RadGridClaim_ctl00 tbody tr';
            var cnt = $(str).length;
            for (var i = 0; i < cnt; i++) {
                // Dropdown section   -----------
                var strApproved = '#ctl00_ContentPlaceHolder1_RadGridClaim_ctl00 tbody tr ';
                var dropdownVal = $($(strApproved)[i]).find('select').val();
                var txtValue = $($(strApproved)[i]).find("td:eq(4) input[type='text']").val();

                if (dropdownVal == "-1") {
                    $($(strApproved)[i]).find('select').focus();
                    document.getElementById('hdnPopUpType').value = false;
                    return false;
                } else if (dropdownVal == "2" && txtValue.trim() === "") // if rejected then make remark mandatory
                {
                    $($(strApproved)[i]).find("td:eq(4) input[type='text']").val("");
                    $($(strApproved)[i]).find("td:eq(4) input[type='text']").focus();
                    $($(strApproved)[i]).find("td:eq(4) input[type='text']").attr("placeholder", "Remark for Rejection");
                    document.getElementById('hdnPopUpType').value = false;
                    return false;
                }
            }
            document.getElementById('hdnPopUpType').value = true;
            return;
            // return false;
        }

        function printcertificate() {
            var DocumentContainer = document.getElementById('printarea').innerHTML;
            var WindowObject = window.open('', "PrintWindow", "width=1000,height=1000,top=0,left=0,toolbars=no,scrollbars=no,status=no,resizable=yes");
            WindowObject.document.writeln(DocumentContainer);
            WindowObject.document.close();
            WindowObject.focus();
            WindowObject.print();
            WindowObject.close();

            //var printContents = document.getElementById('printarea').innerHTML;
            //var originalContents = document.body.innerHTML;

            //document.body.innerHTML = printContents;

            //window.focus();
            //window.print();
            //window.close();

            //document.body.innerHTML = originalContents;

            //window.open('', 'myModalStatus', 'height=400,width=800');
            //window.print();
        }

        function showActionPopup() {
            $("#ViewActionModal").modal("show");
        }

        function HideActionPopup() {
            $("#ViewActionModal").modal("hide");
        }


        function showcertificatePopup() {
            $("#myModalStatus").modal("show");
        }

        function HidecertificatePopup() {
            $("#myModalStatus").modal("hide");
        }


        function showApprovalPopup() {
            $("#FileApprovalModal").modal("show");
        }

        function HideApprovalPopup() {
            $("#FileApprovalModal").modal("hide");
        }

        function ShowAlertPopup() {
            alert("Process started successfully!");
        }




        function showApprovalClaimPopup() {
            $("#FileApprovalModalClaim").modal("show");
        }

        function HideApprovalClaimPopup() {
            $("#FileApprovalModalClaim").modal("hide");
        }

    </script>

