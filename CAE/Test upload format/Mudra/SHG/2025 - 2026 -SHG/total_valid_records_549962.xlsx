    <script type="text/javascript">

        $(document).ready(function () {
            $(".btn").css('font-size', 12);
            $('#incfont').click(function () {

                curSize = parseInt($('#divforfont').css('font-size'));


                $(".RadGrid_Black, .RadGrid_Black .rgMasterTable, .RadGrid_Black .rgDetailTable, .RadGrid_Black .rgGroupPanel table, .RadGrid_Black .rgCommandRow table, .RadGrid_Black .rgEditForm table, .RadGrid_Black .rgPager table").css('font-size', 14);
                $(".labels").css('font-size', 14);
                $("#btnAddMLI").css('font-size', 14);
                $("#btnAddTrust").css('font-size', 14);
                $(".RadComboBox_Default .rcbInput").css('font-size', 14);
                $(".txtMLI").css('font-size', 14);
                $(".radDropdownCss").css('font-size', 14);
                $(".caption").css('font-size', 22);
                $(".btn").css('font-size', 14);
                $('#divforfont').css('font-size', 14);
                $("#mliba").css('font-size', 24);
                $("#TrustCodeValue").css('font-size', 24);
                $(".page-title").css('font-size', 30);
            });

            $('#decfont').click(function () {

                curSize = parseInt($('#divforfont').css('font-size'));


                $(".RadGrid_Black, .RadGrid_Black .rgMasterTable, .RadGrid_Black .rgDetailTable, .RadGrid_Black .rgGroupPanel table, .RadGrid_Black .rgCommandRow table, .RadGrid_Black .rgEditForm table, .RadGrid_Black .rgPager table").css('font-size', 8);
                $(".labels").css('font-size', 8);
                $(".RadComboBox_Default .rcbInput").css('font-size', 8);
                $(".txtMLI").css('font-size', 8);
                $(".radDropdownCss").css('font-size', 8);
                $(".caption").css('font-size', 8);
                $(".btn").css('font-size', 8);
                $("#btnAddMLI").css('font-size', 8);
                $("#btnAddTrust").css('font-size', 8);
                $('#divforfont').css('font-size', 8);
                $("#mliba").css('font-size', 14);
                $("#TrustCodeValue").css('font-size', 14);
                $(".page-title").css('font-size', 20);
            });

            $('#normalfont').click(function () {

                curSize = parseInt($('#divforfont').css('font-size'));
                $(".RadGrid_Black, .RadGrid_Black .rgMasterTable, .RadGrid_Black .rgDetailTable, .RadGrid_Black .rgGroupPanel table, .RadGrid_Black .rgCommandRow table, .RadGrid_Black .rgEditForm table, .RadGrid_Black .rgPager table").css('font-size', 12);
                $(".labels").css('font-size', 11);
                $(".RadComboBox_Default .rcbInput").css('font-size', 12);
                $(".txtMLI").css('font-size', 11);
                $(".radDropdownCss").css('font-size', 11);
                $(".caption").css('font-size', 18);
                $(".btn").css('font-size', 12);
                $('#divforfont').css('font-size', 12);
                $("#btnAddMLI").css('font-size', 12);
                $("#btnAddTrust").css('font-size', 12);
                $("#mliba").css('font-size', 20);
                $("#TrustCodeValue").css('font-size', 20);
                $(".page-title").css('font-size', 25);
            });


        });

    </script>
    

    <script>

        function ScrollToTop() {
            $('html,body').animate({ scrollTop: 0 }, 1000);
        }

        function ScrollToTopPopup() {
            $('html, .modal-body').animate({ scrollTop: 0 }, 1000);
        }

        function isChar(evt) {

            var charCode = (evt.which) ? evt.which : event.keyCode;

            if (!(charCode >= 65 && charCode <= 90) && !(charCode >= 97 && charCode <= 122) && charCode != 8)
                return false;

            return true;

        }

    </script>

